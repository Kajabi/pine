{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  "projectFolder": ".",

  /**
   * The wrapper surface: which `Pds*` components `@pine-ds/react` exports and the shape of
   * each generated `forwardRef` signature. The prop detail itself lives in `@pine-ds/core`
   * and is intentionally *not* inlined here — the props referenced as `JSX_2.PdsButton`
   * are reported in full by libs/core/etc/core.api.md. Bundling core into this report
   * would duplicate 3k lines and make every core prop change produce two diffs.
   *
   * Run `npx nx run @pine-ds/react:build` before extracting.
   */
  "mainEntryPointFilePath": "<projectFolder>/dist/types/index.d.ts",

  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/temp/api-report/"
  },

  /** The doc model and .d.ts rollup are review aids we don't consume; keep the diff small. */
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },

  "messages": {
    "compilerMessageReporting": {
      "default": { "logLevel": "warning" }
    },

    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },

      /** Pine does not use API Extractor release tags — see libs/core/api-extractor.json. */
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-internal-missing-underscore": { "logLevel": "none" },

      /**
       * `StyleReactProps` is part of every wrapper's signature but is not re-exported from
       * the entry point. It still appears in the report, so changes to it are still caught.
       */
      "ae-forgotten-export": { "logLevel": "none" }
    },

    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    }
  }
}
